{
  "name": "weblive-chat",
  "version": "1.0.0",
  "description": "WebLive Chat —— 免登录、可直接部署到 Vercel 的实时聊天后端：SSE 实时广播与在线人数、可插拔存储（SQLite/Turso/PostgreSQL）、管理后台与 IP 封禁",
  "type": "module",
  "license": "MIT",
  "author": "Damon Lu",
  "engines": {
    "bun": ">=1.2"
  },
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "start": "bun src/index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "test:pg": "DB_PROVIDER=postgres bun test tests/integration"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "hono": "^4.13.7",
    "postgres": "^3.4.9"
  }
}
