# Dependencies
node_modules/

# Environment — never commit real secrets; copy .env.example for local dev
.env
.env.*
!.env.example

# Build output
dist/
build/
out/

# Vercel
.vercel/

# Logs & OS
*.log
npm-debug.log*
.DS_Store

# Test / coverage
coverage/

# Local dev database (SQLite)
data/*.db
data/*.db-journal
data/*.db-wal
data/*.db-shm

# Wordlists must be committed: vercel.json includeFiles bundles them into the function
!data/banned/
!data/banned/**

# local worktrees
.worktrees/
