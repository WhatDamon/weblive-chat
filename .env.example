# ---- Database ----
DB_PROVIDER=sqlite            # sqlite | postgres | memory
DATABASE_URL=file:./data/dev.db   # sqlite: file: for local dev only; production SQLite must be remote (Turso)
# memory: local demo/test only, empty after restart, not for Vercel or production (DATABASE_URL ignored)
# production SQLite (Turso): DATABASE_URL=libsql://<db>-<org>.turso.io plus TURSO_AUTH_TOKEN
# production Postgres (Neon/Supabase/self-hosted): DATABASE_URL=postgres://user:pass@host/db?sslmode=require
TURSO_AUTH_TOKEN=
DB_MIGRATE_ON_BOOT=true       # idempotent CREATE TABLE IF NOT EXISTS before the first request
MAINTENANCE_EVERY=100         # evaluate retention and clean up every N writes
DEV_IP=127.0.0.1              # fallback IP when x-forwarded-for is absent (local dev/test only)
ADMIN_SESSION_DAYS=7          # admin session cookie lifetime, in days
NODE_ENV=development          # Vercel sets production, where a missing ADMIN_SECRET refuses to boot

# ---- Admin (required: production refuses to boot without it) ----
ADMIN_SECRET=replace-with-a-long-random-string

# ---- Origin allowlist ----
# empty = open mode; exact Origins, comma separated, including https:// and no path or trailing slash
# "*" equals empty; once set, list this deployment's own domain too or same-origin pages get 403
# after changing domains, update this variable and redeploy
ALLOWED_ORIGINS=
REQUIRE_ORIGIN=0              # 1 = also reject requests carrying no Origin (separate rule)

# ---- Chat / retention ----
NICK_MAX=24
TEXT_MAX=1000
BANNED_WORDS_MODE=basic        # off=explicit words only | basic=data/banned/basic | strict=+data/banned/strict
BANNED_WORDS_DIR=              # wordlist directory, default <cwd>/data/banned
BANNED_WORDS_ALLOW=            # allowlist: hits fully covered by these phrases are exempt
BANNED_WORDS=                  # extra words, comma separated, merged with the wordlists
HISTORY_RETENTION_DAYS=90
HISTORY_MAX_ROWS=500000
HISTORY_MAX_BACKFILL=0        # 0 = unlimited backtracking; N = the most recent N rows only

# ---- Rate limits (per IP, 60s window) ----
MSG_RATE_PER_MIN=10
STREAM_RATE_PER_MIN=20
LOGIN_RATE_PER_MIN=5
# destructive ops (purge): preview and execute share one bucket
PURGE_RATE_PER_MIN=5

# ---- Runtime ----
PORT=3000
