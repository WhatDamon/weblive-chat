# ---- 数据库（本实现期不引 ORM，见规格 D16）----
DB_PROVIDER=sqlite            # sqlite | postgres | memory
# sqlite：本地开发/测试用 file:；生产 SQLite 必须走远程 Turso（Vercel 文件系统临时）
DATABASE_URL=file:./data/dev.db
# memory（仅本地/单实例演示与测试，重启即空；不适用于 Vercel/生产）：DB_PROVIDER=memory，DATABASE_URL 忽略
# 生产 SQLite（Turso）：DATABASE_URL=libsql://<db>-<org>.turso.io  另需 TURSO_AUTH_TOKEN
# 生产 Postgres（Neon/Supabase/自建）：DATABASE_URL=postgres://user:pass@host/db?sslmode=require
TURSO_AUTH_TOKEN=
DB_MIGRATE_ON_BOOT=true       # 启动幂等建表（首次请求前 CREATE TABLE IF NOT EXISTS）
MAINTENANCE_EVERY=100         # 每 N 次写入触发一次保留期评估/清理
DEV_IP=127.0.0.1              # 无 x-forwarded-for 时的回退 IP（仅本地开发/测试）
ADMIN_SESSION_DAYS=7          # 管理会话 Cookie 有效天数
NODE_ENV=development          # Vercel 自动置 production（此时未设 ADMIN_SECRET 拒绝启动）

# ---- 管理员（必配：生产不设则启动失败）----
ADMIN_SECRET=replace-with-a-long-random-string

# ---- 来源白名单 ----
# 空 = 开放模式；逗号分隔精确 Origin（含 https://，不要带路径/末尾斜杠），如 https://a.com,http://localhost:3000
# 写 * 等价于留空；设置后必须把部署自身域名一并列入，否则同源页面（/demo.html、/admin）的写请求会被 403 拒
# 换域名后需同步更新本变量并重新部署
ALLOWED_ORIGINS=
REQUIRE_ORIGIN=0              # 1 = 无 Origin 直连拒绝（与「来源不在白名单」是两条独立规则）

# ---- 聊天/保留 ----
NICK_MAX=24
TEXT_MAX=1000
BANNED_WORDS_MODE=basic        # off=仅用显式词 | basic=加载 data/banned/basic | strict=再加载 data/banned/strict
BANNED_WORDS_DIR=              # 词库目录，缺省 <cwd>/data/banned
BANNED_WORDS_ALLOW=            # 白名单：命中区间被其覆盖时豁免，如 赌博合法
BANNED_WORDS=                  # 显式追加禁词（逗号分隔，与词库合并）
HISTORY_RETENTION_DAYS=90
HISTORY_MAX_ROWS=500000
HISTORY_MAX_BACKFILL=0        # 0=不限制回溯深度；正整数=仅回溯最近 N 条

# ---- 限流（每 IP / 60s 窗口）----
MSG_RATE_PER_MIN=10
STREAM_RATE_PER_MIN=20
LOGIN_RATE_PER_MIN=5
# 危险操作（清空数据）：预检与执行共用同一桶
PURGE_RATE_PER_MIN=5

# ---- 运行 ----
PORT=3000
